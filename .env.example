VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Sentinel Hub (Copernicus) — Instance ID de la configuration WMS.
# Dashboard → Configurations → tu configuración → "ID" (Service Endpoint).
# Opcional: si se omite, GeoMonitor pide el Instance ID una vez por prompt().
VITE_SENTINEL_INSTANCE_ID=YOUR_SENTINEL_HUB_INSTANCE_ID_HERE

# CARTO (basemap oscuro del mapa en PublicMonitor) — "CARTO Basemaps API
# key" gratuito, se pide en carto.com/basemaps/apikey (llega por correo,
# sin necesidad de cuenta CARTO). NO es el "API Access Token" del dashboard
# de una organización CARTO (ese es para Maps API/datos propios y no sirve
# para autenticar este endpoint). Sin esta env var, el mapa sigue
# funcionando pero con una marca de agua "API KEY REQUIRED" superpuesta.
VITE_CARTO_ACCESS_TOKEN=YOUR_CARTO_BASEMAPS_KEY_HERE
